{
  "name": "events-calendar-live-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "An auto-updating live viewer for virtual events in The Events Calendar.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernskiold/events-calendar-live-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/bernskiold/events-calendar-live-viewer/issues"
  },
  "homepage": "https://github.com/bernskiold/events-calendar-live-viewer#readme",
  "author": {
    "name": "Bernskiold",
    "email": "info@bernskiold.com",
    "url": "https://bernskiold.com",
    "role": "developer"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "npm install && composer install && npm run build",
    "build": "wp-scripts build && wp-scripts build-blocks-manifest --input=blocks --output=blocks/blocks-manifest.php",
    "dev": "wp-scripts start",
    "i18n": "npm run i18n:pot",
    "i18n:pot": "npm run build && wp i18n make-pot . ./languages/events-calendar-live-viewer.pot --include=\"dist/,src/,blocks/\"",
    "i18n:makejed": "wp i18n make-json languages --no-purge",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format ./blocks ./assets/scripts",
    "lint": "npm run lint:js",
    "lint:js": "wp-scripts lint-js",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^7.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/scripts": "^37.1.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "webpackbar": "^7.0.0"
  }
}
