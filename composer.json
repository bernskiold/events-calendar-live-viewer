{
  "name": "bernskioldmedia/events-calendar-live-viewer",
  "description": "An auto-updating live viewer for virtual events in The Events Calendar.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bernskiold",
      "email": "info@bernskiold.com",
      "homepage": "https://bernskiold.com"
    }
  ],
  "support": {
    "source": "https://github.com/bernskiold/events-calendar-live-viewer",
    "issues": "https://github.com/bernskiold/events-calendar-live-viewer/issues"
  },
  "require": {
    "php": "^7.4|^8.0",
    "composer/installers": "^1.0 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "BernskioldMedia\\WP\\EventsCalendarLiveViewer\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
