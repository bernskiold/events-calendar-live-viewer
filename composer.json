{
  "name": "bernskioldmedia/events-calendar-live-viewer",
  "description": "An auto-updating live viewer for virtual events in The Events Calendar.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bernskiold",
      "email": "info@bernskiold.com",
      "homepage": "https://bernskiold.com"
    }
  ],
  "support": {
    "source": "https://github.com/bernskiold/events-calendar-live-viewer",
    "issues": "https://github.com/bernskiold/events-calendar-live-viewer/issues"
  },
  "require": {
    "php": "^8.2",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "BernskioldMedia\\WP\\EventsCalendarLiveViewer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BernskioldMedia\\WP\\EventsCalendarLiveViewer\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  }
}
